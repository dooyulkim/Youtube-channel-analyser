    "commander": "^11.1.0",
    "dotenv": "^16.3.1",
    "https-proxy-agent": "^7.0.2"
  },
  "devDependencies": {
    "@types/node": "^20.10.6",
    "rimraf": "^5.0.5",
    "tsx": "^4.7.0",
    "typescript": "^5.3.3"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
