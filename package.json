{
  "name": "youtube-channel-analyzer",
  "version": "1.0.0",
  "description": "Benchmark popular YouTube channels using the YouTube Data API",
  "main": "dist/index.js",
  "type": "module",
  "bin": {
    "analyze-channels": "./dist/index.js"
  },
  "scripts": {
    "build": "tsc",
    "start": "node dist/index.js",
    "dev": "tsx src/index.ts",
    "analyze": "tsx src/index.ts",
    "clean": "rimraf dist",
    "prebuild": "npm run clean"
  },
  "keywords": [
